generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  USER
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String?
  telefono  String?
  ciudad    String?
  edad      Int?
  cargo     String?
  rol       Rol        @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  activities Activity[] @relation("UserActivities")
}

model Activity {
  id        Int      @id @default(autoincrement())
  content   String
  userEmail String
  createdAt DateTime @default(now())

  user User @relation("UserActivities", fields: [userEmail], references: [email])
}

model ResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
}

model Lote {
  id          String   @id @default(uuid())
  nombre      String
  tipo        String
  cantidad    Int
  fechaInicio DateTime @default(now())
  createdAt   DateTime @default(now())

  eventos Evento[] // ← Relación inversa
}

model Evento {
  id          String   @id @default(uuid())
  loteId      String
  tipo        String // Vacuna, Tratamiento, Alimentación
  descripcion String?
  fecha       DateTime
  createdAt   DateTime @default(now())

  lote Lote @relation(fields: [loteId], references: [id])
}

model Insumo {
  id        String       @id @default(uuid())
  nombre    String
  categoria String
  unidad    String
  stock     Float
  minimo    Float
  updatedAt DateTime     @updatedAt

  movimientos Movimiento[]
}

model Movimiento {
  id       String   @id @default(uuid())
  insumoId String
  tipo     String // Entrada o Salida
  cantidad Float
  fecha    DateTime
  insumo   Insumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)
}